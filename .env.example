# Copiar este archivo como .env y poner valores propios.
# .env esta en .gitignore: las contrasenas reales nunca se suben a Git.
#
# Todas son obligatorias: con el perfil prod, si falta una el backend
# no arranca.

# Usuario y contrasena de PostgreSQL
DB_USER=inventario
DB_PASSWORD=cambiar

# Clave para firmar los tokens JWT (minimo 32 caracteres)
JWT_SECRET=cambiar-por-un-texto-aleatorio-de-al-menos-32-caracteres

# Contrasenas de los usuarios iniciales en produccion (minimo 8 caracteres).
# Reemplazan las de demostracion (Admin123* y Tendero123*).
ADMIN_PASSWORD=cambiar
TENDERO_PASSWORD=cambiar
