              ]
            },
            "description": "RF-20, RN-01, RN-10: 10 de entrada menos 4 de venta, minimo 5."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK, existencia 6 y estado EN_STOCK\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.existencia).to.eql(6);",
                  "    pm.expect(json.estado).to.eql(\"EN_STOCK\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
