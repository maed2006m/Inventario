{
  "info": {
    "name": "Inventario Tienda de Barrio - Entrega 2",
    "description": "Coleccion de pruebas de API. Ejecutar en orden con el Collection Runner: el login guarda el token y las creaciones guardan los ids que usan las peticiones siguientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenTendero",
      "value": ""
    },
    {
      "key": "proveedorId",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Autenticacion",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda el token de ADMIN en la variable de coleccion para las demas peticiones.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123*\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK y devuelve token\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(json.rol).to.eql(\"ADMIN\");",
                  "    pm.collectionVariables.set(\"token\", json.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login tendero",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Token de TENDERO, usado en la carpeta 05 para comprobar los 403.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"tendero\",\n  \"password\": \"Tendero123*\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK con rol TENDERO\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.rol).to.eql(\"TENDERO\");",
                  "    pm.collectionVariables.set(\"tokenTendero\", json.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con clave incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "RNF-09. El mensaje no debe revelar si el usuario existe.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"ClaveMala123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 Unauthorized\", () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().accion).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Datos del usuario autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK con datos del usuario\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().username).to.eql(\"admin\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
